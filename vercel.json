{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl -sL https://github.com/gohugoio/hugo/releases/download/v0.140.2/hugo_extended_0.140.2_linux-amd64.tar.gz | tar xz hugo",
  "buildCommand": "./hugo --minify --baseURL \"https://${VERCEL_PROJECT_PRODUCTION_URL:-localhost}/\" && python3 scripts/build-zips.py",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
